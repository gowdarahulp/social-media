# Application Config
APP_NAME="Social Media Analytics Framework"
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Anonymization
HASH_SALT=social-pulse-secret-salt-2026
K_ANONYMITY_THRESHOLD=20

# Database
DATABASE_PATH=social_pulse.db
DATABASE_URL=sqlite:///./social_pulse.db

# Ingestion / Demo
REPLAY_DATASET_PATH=backend/app/data/sample_dataset.jsonl
REPLAY_SPEED_MULTIPLIER=1.0

# Optional Live API Credentials (Uncomment for live mode)
# TWITTER_BEARER_TOKEN=your_x_bearer_token
# TELEGRAM_API_ID=your_telegram_api_id
# TELEGRAM_API_HASH=your_telegram_api_hash
# TELEGRAM_PHONE=+1234567890
